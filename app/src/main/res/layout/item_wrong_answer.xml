<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#FFF8F8"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="#FFCDD2"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_wrong_item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/eco_accent_pink"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Пластиковая бутылка" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_user_choice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/eco_accent_pink"
                android:textSize="13sp"
                tools:text="Выбрано: БУМАГА" />

            <TextView
                android:id="@+id/tv_right_choice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/eco_contour_turquoise"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Правильно: ПЛАСТИК" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>